# ==============================================================================
# Apache Hadoop & Spark Big Data Engineering Ecosystem - Environment Variables
# ==============================================================================

# Hadoop Version & Images
HADOOP_VERSION=3.1.2
IMAGE_NAME=hadoop-cluster:3.1.2
CONTAINER_NAME=hadoop-master

# Hadoop Ports
HADOOP_NAMENODE_PORT=9870
HADOOP_DATANODE_PORT=9864
HADOOP_RESOURCEMANAGER_PORT=8088
HADOOP_NODEMANAGER_PORT=8042
HADOOP_JOBHISTORY_PORT=19888
HADOOP_HDFS_RPC_PORT=9000
HADOOP_SSH_PORT=22222

# Apache Spark Ports
SPARK_MASTER_PORT=8080
SPARK_MASTER_RPC_PORT=7077
SPARK_WORKER_PORT=8081
SPARK_HISTORY_PORT=18080

# JupyterLab & Big Data Control Hub
JUPYTER_PORT=8888
BIGDATA_PORTAL_PORT=3030
